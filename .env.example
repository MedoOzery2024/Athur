# =============================================================================
# ATHUR · Backend environment variables (TEMPLATE — no real secrets here)
# =============================================================================
# Copy this file to `.env` (which is git-ignored) and fill in real values, OR
# set these as real environment variables in your shell / CI secret store.
#
# NEVER commit `.env` or any file containing real credentials.
# =============================================================================

# --- Server -----------------------------------------------------------------
ATHUR_ENV=development
ATHUR_HOST=0.0.0.0
ATHUR_PORT=8080

# --- PostgreSQL (REQUIRED) --------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# In production always append ?sslmode=verify-full
ATHUR_DATABASE_URL=postgresql://athur:athur_dev_pw@localhost:5432/athur

# --- Auth tokens (added in the authentication phase) ------------------------
# Long random secret used to sign/verify short-lived access tokens.
# Generate with:  openssl rand -base64 48   (or any CSPRNG)
# ATHUR_JWT_SECRET=

# --- Firebase Admin (FCM HTTP v1) -------------------------------------------
# Absolute path to the service-account JSON. KEEP THIS FILE OUT OF THE REPO.
# Example (Windows): D:\Secrets\athur-firebase-service-account.json
# ATHUR_FIREBASE_SERVICE_ACCOUNT=

# --- Metered TURN (added in the TURN phase) ---------------------------------
# Secret API key used ONLY on the server to mint short-lived TURN credentials.
# It is never sent to, or stored in, the Flutter app.
# ATHUR_METERED_API_KEY=
# ATHUR_METERED_DOMAIN=

# --- Object storage for media (added in the media phase) --------------------
# S3-compatible endpoint + bucket + keys (server-side only).
# ATHUR_S3_ENDPOINT=
# ATHUR_S3_BUCKET=
# ATHUR_S3_ACCESS_KEY=
# ATHUR_S3_SECRET_KEY=
# ATHUR_S3_REGION=
